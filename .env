# Paramètres d'infrastructure versionnés. Les secrets réels vont dans .env.local.
COMPOSE_PROJECT_NAME=trouve-ton-artisan
APP_DEV_IMAGE_TAG=development
APP_PROD_IMAGE_TAG=production
NODE_VERSION=22
MYSQL_VERSION=8.4
NGINX_IMAGE=nginxinc/nginx-unprivileged
NGINX_VERSION=1.29

FRONTEND_PORT=5173

DB_NAME=trouve_ton_artisan
DB_TEST_NAME=trouve_ton_artisan_test
DB_USER=artisan_app
DB_PASSWORD=replace-with-a-secure-password
DB_ROOT_PASSWORD=replace-with-another-secure-password

TRAEFIK_HOST=trouve-ton-artisan.srv924756.hstgr.cloud
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=lehttp
SITE_URL=https://trouve-ton-artisan.srv924756.hstgr.cloud

# Adresse exacte de Traefik sur proxy ; boucle locale = aucun proxy distant approuvé.
TRAEFIK_TRUSTED_IP=127.0.0.1
