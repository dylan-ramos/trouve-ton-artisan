# Configuration applicative non sensible.
PORT=3000
DB_HOST=database
DB_PORT=3306
LOG_LEVEL=info

# En développement, l'absence de SMTP_HOST active le transport JSON local.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=no-reply@trouve-ton-artisan.fr

